# {{ app_name }} Configuration
# Generated by Ansible on {{ ansible_date_time.date }} at {{ ansible_date_time.time }}

[app]
name = {{ app_name }}
port = {{ app_port }}
user = {{ app_user }}
directory = {{ app_directory }}

[server]
hostname = {{ inventory_hostname }}
environment = {{ environment | default('development') }}
debug = {{ debug_mode | default('false') }}

[database]
host = {{ database_host | default('localhost') }}
port = {{ database_port | default('3306') }}
name = {{ database_name | default(app_name + '_db') }}
user = {{ database_user | default(app_name + '_user') }}

[logging]
level = {{ log_level | default('INFO') }}
file = {{ app_directory }}/logs/app.log
max_size = {{ log_max_size | default('10MB') }}

{% if ansible_memtotal_mb > 2048 %}
[performance]
# High memory system - enable caching
cache_enabled = true
cache_size = {{ (ansible_memtotal_mb * 0.1) | int }}MB
{% else %}
[performance]
# Low memory system - disable caching
cache_enabled = false
{% endif %}

# Custom settings per environment
{% if environment == 'production' %}
[security]
ssl_enabled = true
strict_mode = true
{% elif environment == 'development' %}
[security]
ssl_enabled = false
strict_mode = false
{% endif %}